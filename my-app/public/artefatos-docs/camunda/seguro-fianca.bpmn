    <bpmn:textAnnotation id="TextAnnotation_1k1iuzg">
      <bpmn:text>Dados iniciais do seguro, do pretendente e do imóvel.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0celog1">
      <bpmn:text>Nesta etapa, são incluídos os arquivo do orçamento e do contrato de locação, além do prêmio e seguradora acordados (registrados em log).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0c0x8mt" associationDirection="None" sourceRef="Activity_0j761qh" targetRef="TextAnnotation_0celog1" />
    <bpmn:textAnnotation id="TextAnnotation_1la6q58">
      <bpmn:text>Atualização da base de produção.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1amb76d">
      <bpmn:text>Aqui serão incluídos os dados do proprietário, forma de pagamento, prêmio e código de apólice</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1vnke17" associationDirection="None" sourceRef="Activity_0y5sklr" targetRef="TextAnnotation_1la6q58" />
    <bpmn:association id="Association_0zwxpf7" associationDirection="None" sourceRef="Activity_0y5sklr" targetRef="TextAnnotation_1amb76d" />
    <bpmn:textAnnotation id="TextAnnotation_1f02mo8">
      <bpmn:text>Negociações, e tratativas com o cliente ocorrem aqui.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_15hqrgw" associationDirection="None" sourceRef="Activity_0fire0b" targetRef="TextAnnotation_1f02mo8" />
    <bpmn:textAnnotation id="TextAnnotation_13gcpj7">
      <bpmn:text>Ator utiliza os portais da seguradora.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0hmkdje" associationDirection="None" sourceRef="Activity_0fire0b" targetRef="TextAnnotation_13gcpj7" />
  </bpmn:collaboration>
