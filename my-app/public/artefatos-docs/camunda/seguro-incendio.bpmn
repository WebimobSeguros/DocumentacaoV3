    <bpmn:textAnnotation id="TextAnnotation_1k1iuzg">
      <bpmn:text>Dados iniciais do seguro, do pretendente e do imóvel.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0fdq4p8">
      <bpmn:text>Pode ser Porto ou Tokio. Depende da parametrização da imobiliária.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_12fx9z6" associationDirection="None" sourceRef="Participant_0bbkbwo" targetRef="TextAnnotation_0fdq4p8" />
    <bpmn:textAnnotation id="TextAnnotation_1vxg5c3">
      <bpmn:text>Orçamento é excluído do banco da Webimob</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1uobcxq" associationDirection="None" sourceRef="Activity_18ddb3u" targetRef="TextAnnotation_1vxg5c3" />
    <bpmn:textAnnotation id="TextAnnotation_0celog1">
      <bpmn:text>Nesta etapa, são incluídos os dados do proprietário, antes do envio da solicitação.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0c0x8mt" associationDirection="None" sourceRef="Activity_0j761qh" targetRef="TextAnnotation_0celog1" />
  </bpmn:collaboration>
