  <bpmn:collaboration id="Collaboration_1urogw9">
    <bpmn:participant id="Participant_1fwefae" name="Solicitação de Abertura de Sinistro" processRef="Process_0kmy9oi" />
    <bpmn:textAnnotation id="TextAnnotation_0myr5iu">
      <bpmn:text>Abertura do sinistro só pode ser feita apos a apolice</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_0ny5y3i">
      <bpmn:text>A Imobiliaria é notificada sobre a ocorrência de um sinistro</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_134v3ed" associationDirection="None" sourceRef="Activity_07ydh0x" targetRef="TextAnnotation_0myr5iu" />
    <bpmn:association id="Association_0hoyziw" associationDirection="None" sourceRef="Event_1vo4dp7" targetRef="TextAnnotation_0ny5y3i" />
    <bpmn:textAnnotation id="TextAnnotation_11mmsy9">
      <bpmn:text>Imóvel ocupado, data de ocorrência, e-mail, anexos...</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_04lqueu" associationDirection="None" sourceRef="Activity_0idv5y5" targetRef="TextAnnotation_11mmsy9" />
    <bpmn:textAnnotation id="TextAnnotation_01dks6z">
      <bpmn:text>Solicitação começa com status 'Novo'</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1m98hkj" associationDirection="None" sourceRef="Activity_07ydh0x" targetRef="TextAnnotation_01dks6z" />
    <bpmn:textAnnotation id="TextAnnotation_13pwgpg">
      <bpmn:text>O usuário Webimob pode alterar o status da solicitação (ex: documentação pendente, em acordo, etc.)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1iwhs9v" associationDirection="None" sourceRef="Activity_1jt2o76" targetRef="TextAnnotation_13pwgpg" />
  </bpmn:collaboration>
